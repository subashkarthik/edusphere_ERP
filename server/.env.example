# EduSphere LMS — Backend Configuration

# Database: SQLite (default dev) or PostgreSQL (production)
DATABASE_URL=sqlite:///./edusphere.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/edusphere

# Security & JWT
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Registration Keys
FACULTY_INVITE_KEY=faculty_secure_key_2026

# Environment
ENVIRONMENT=development
# ENVIRONMENT=production

# Frontend URL (for Certificate QR codes & CORS)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000
