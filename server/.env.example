# UniVerse ERP — Backend Configuration

# Database
DATABASE_URL=sqlite:///./universe.db

# Security
JWT_SECRET_KEY=generate-a-strong-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# institutional AI
# Get your API key from https://aistudio.google.com/
API_KEY=your-gemini-api-key-here

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# MS Access Integration
# Path to the directory containing institutional .accdb files
ACCESS_DB_DIR=C:\Path\To\Your\Access\Databases
